## Threads backend configuration (copy to `.env` and fill in)

# Supabase
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Use ONE of these (service_role recommended for backend writes)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Do not use the JWT secret (sb_secret_...) or database connection strings here.

# API
API_HOST=0.0.0.0
API_PORT=8000

# Optional: bounded LLM rewrite (disabled by default)
# THREADS_LLM_MODE=off
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_TIMEOUT_S=20
