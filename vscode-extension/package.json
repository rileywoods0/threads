{
  "name": "threads-memory",
  "displayName": "Threads Memory Prototype",
  "description": "Capture and recall developer context using a Threads backend.",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "activationEvents": [
    "onStartupFinished",
    "onCommand:threads.showLastState",
    "onCommand:threads.saveStateNow",
    "onCommand:threads.openSummaryFile",
    "onCommand:threads.browseSnapshots",
    "onCommand:threads.checkBackend",
    "onCommand:threads.exportContextBundle",
    "onCommand:threads.resumeWhereILeftOff",
    "onView:threads.view"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "contributes": {
    "commands": [
      {
        "command": "threads.showLastState",
        "title": "Threads: Show Last State"
      },
      {
        "command": "threads.saveStateNow",
        "title": "Threads: Save State Now"
      },
      {
        "command": "threads.openSummaryFile",
        "title": "Threads: Open Last Summary Markdown"
      },
      {
        "command": "threads.browseSnapshots",
        "title": "Threads: Browse Snapshots"
      },
      {
        "command": "threads.checkBackend",
        "title": "Threads: Check Backend Health"
      },
      {
        "command": "threads.showOutput",
        "title": "Threads: Show Output Log"
      },
      {
        "command": "threads.exportContextBundle",
        "title": "Threads: Export Context Bundle (Markdown)"
      },
      {
        "command": "threads.resumeWhereILeftOff",
        "title": "Threads: Resume Where I Left Off"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "threads",
          "title": "Threads",
          "icon": "media/threads.svg"
        }
      ]
    },
    "views": {
      "threads": [
        {
          "id": "threads.view",
          "name": "Threads"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "Threads",
      "properties": {
        "threads.backendUrl": {
          "type": "string",
          "default": "http://localhost:8000",
          "description": "Base URL for the Threads backend API"
        },
        "threads.eventFlushIntervalMs": {
          "type": "number",
          "default": 5000,
          "description": "How often to flush queued events (milliseconds)."
        },
        "threads.resumeMode": {
          "type": "string",
          "enum": ["quiet", "prompt", "off"],
          "default": "quiet",
          "description": "Resume UX on workspace open (quiet shows indicators only; prompt shows a message)."
        },
        "threads.resumePrompt": {
          "type": "boolean",
          "default": true,
          "description": "Deprecated; use threads.resumeMode. If set, true behaves like 'prompt' and false like 'off'."
        }
      }
    }
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3"
  }
}
