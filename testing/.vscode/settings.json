{
  "threads.backendUrl": "http://localhost:8000",
  "threads.eventFlushIntervalMs": 2000,
  "threads.autoCheckpoint.enabled": true,
  "threads.autoCheckpoint.intervalMinutes": 3,
  "threads.autoCheckpoint.idleMinutes": 2,
  "threads.autoCheckpoint.minMeaningfulScore": 10,
  "threads.autoCheckpoint.onShutdown": true,
  "threads.autoCheckpoint.onBranchChange": true,
  "threads.resume.longBreakHours": 1,
  "threads.export.maxFiles": 10,
  "threads.export.redactHomeDir": true,
  "threads.export.includeFilePaths": true,
  "files.autoSave": "off",
  "editor.minimap.enabled": false
}
